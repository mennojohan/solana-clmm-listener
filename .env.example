# Solana RPC Configuration (Get a free key at https://helius.dev)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE
RPC_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE
MAX_CONCURRENT_RPC=3
RPC_DELAY_SECONDS=0.1

# Target Orca Whirlpool Address (Default: SOL/USDC 0.05% pool)
WHIRLPOOL_ADDRESS=HJPjoWUrhoZzkNfRpHuieeFk9WcZWjwy6PBjZ81ngndJ

# PostgreSQL / TimescaleDB Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solana_clmm
DB_USER=clmm_user
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE
